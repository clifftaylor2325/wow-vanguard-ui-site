# Text files are kept as LF in the repo and in checkouts (see CONTRIBUTING.md).
* text=auto eol=lf

# Binaries: never touch their bytes.
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
